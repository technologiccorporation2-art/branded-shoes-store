ADMIN_PASSWORD=replace-this-with-a-long-unique-password
# Configure these with your real merchant payment instructions.
BKASH_MERCHANT_NUMBER=01XXXXXXXXX
NAGAD_MERCHANT_NUMBER=01XXXXXXXXX
STORE_NAME=Branded Shoes.com
